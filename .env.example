# ╔══════════════════════════════════════════════════════════════════╗
# ║  LinkWeb — Environment Variables                                ║
# ║  Copy this file to .env and fill in your values                 ║
# ║  WARNING: .env contains secrets — NEVER commit it to git        ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Database ─────────────────────────────────────────────────────
# SQLite (default, zero-config for local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (uncomment for production)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/linkweb"

# ─── NextAuth.js ───────────────────────────────────────────────────
# The base URL of your deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:2222"

# Generate with: openssl rand -base64 32
# Required for JWT signing and cookie encryption
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# ─── OAuth Providers ───────────────────────────────────────────────
# GitHub OAuth App: https://github.com/settings/developers
#   - Homepage URL: http://localhost:2222
#   - Authorization callback URL: http://localhost:2222/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_SECRET=""

# Google OAuth 2.0: https://console.cloud.google.com/apis/credentials
#   - Authorized redirect URIs: http://localhost:2222/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""

# ─── Cloudflare Turnstile ──────────────────────────────────────────
# Frontend site key. Safe to expose in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Backend secret key. Never expose this in frontend code or commits.
TURNSTILE_SECRET_KEY=""

# ─── Optional — Application Settings ───────────────────────────────
# Set to "false" to hide the registration UI and reject /api/auth/register.
REGISTRATION_ENABLED="true"

# NEXT_PUBLIC_APP_NAME="LinkWeb"
# ANALYTICS_RETENTION_DAYS=90
# UPLOAD_MAX_SIZE_MB=5
