// ╔══════════════════════════════════════════════════════════════╗
// ║  LinkWeb — Prisma Database Schema v2.0                       ║
// ║  Provider: SQLite (default) · PostgreSQL (production)        ║
// ║  Auth: NextAuth.js v5 (OAuth 2.0: GitHub, Google)            ║
// ╚══════════════════════════════════════════════════════════════╝

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  NextAuth.js v5 标准模型
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  username      String?   @unique
  passwordHash  String?   // bcrypt hash for credentials-based auth
  customDomain  String?   @unique // custom domain for white-label (e.g. "link.mybrand.com")
  isBanned      Boolean   @default(false)
  bannedAt      DateTime?
  bannedReason  String?
  allowCustomCSS  Boolean @default(true)
  allowCustomFont Boolean @default(true)
  allowTips       Boolean @default(true)
  role                  String  @default("USER") // "USER" | "ADMIN"
  permManageUsers       Boolean @default(false)  // user governance permission
  permDeleteUsers       Boolean @default(false)  // high risk: hard delete users
  permManageLinks       Boolean @default(false)  // content review permission
  permManageSettings    Boolean @default(false)  // global site settings permission
  permToggleMaintenance Boolean @default(false)  // high risk: maintenance mode toggle
  permViewUsers              Boolean @default(false) // view user directory
  permBanUsers               Boolean @default(false) // ban / unban users
  permEditUsers              Boolean @default(false) // edit user profile and assets
  permResetUserPasswords     Boolean @default(false) // reset regular user passwords
  permManageUserEntitlements Boolean @default(false) // toggle CSS/font/tip entitlements
  permViewLinks              Boolean @default(false) // view global link review pool
  permDeleteLinks            Boolean @default(false) // delete / take down links
  permManageSiteSettings     Boolean @default(false) // edit public site display settings
  permManageAuthSettings     Boolean @default(false) // edit registration and OAuth flags
  permRunMaintenance         Boolean @default(false) // run cleanup operations

  // Relations
  accounts      Account[]
  links         Link[]
  themeConfig   ThemeConfig?
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("super_admin")
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                  String   @id @default("global")
  siteTitle           String   @default("LinkWeb")
  seoDescription      String   @default("Self-hosted link-in-bio platform")
  supportEmail        String?
  adminContactLabel   String?
  adminContactUrl     String?
  siteIconUrl         String?
  announcementEnabled Boolean  @default(false)
  announcementText    String?
  footerText          String   @default("© 2026 PAWN. All rights reserved.")
  githubUrl           String   @default("https://github.com/bedlatess/LinkwebBeta")
  registrationEnabled Boolean  @default(true)
  oauthEnabled        Boolean  @default(true)
  isMaintenanceMode   Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model IpBanRule {
  id        String   @id @default(cuid())
  value     String   @unique // single IP or CIDR, e.g. 1.2.3.4 or 1.2.3.0/24
  reason    String?
  source    String   @default("manual") // "manual" | "auto"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([source])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth" | "email" | "credentials"
  provider          String  // "github" | "google"
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════
//  LinkWeb 业务模型
// ═══════════════════════════════════════════════════════════════

model Link {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  iconName  String?  // Lucide icon identifier (e.g. "github", "twitter", "youtube")
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  groupName String?  // Optional grouping label for visual sections

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitLogs VisitLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, sortOrder])
}

model ThemeConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  bgType      String   @default("color")   // "color" | "image" | "gradient"
  bgValue     String   @default("#0a0a0a") // hex color / image path / gradient CSS
  bgBlur      Int      @default(0)         // px value for backdrop-filter
  buttonStyle String   @default("rounded") // "rounded" | "pill" | "square"
  fontFamily  String?                      // font-family string or Google Font name
  customCSS   String?                      // raw CSS override (escape hatch)

  // ─── Tip / Donation config ───
  tipEnabled    Boolean  @default(false)   // show tip button on public page?
  tipTitle      String?                    // custom button text (default: "☕ 赞助我")
  paypalEmail   String?                    // PayPal.me email
  customTipUrl  String?                    // third-party tip link (Ko-fi, 爱发电, BuyMeACoffee)
  cryptoAddress String?                    // crypto wallet address (ETH/BTC/SOL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model VisitLog {
  id        String   @id @default(cuid())
  linkId    String
  ipHash    String   // SHA-256 hash of visitor IP (privacy-preserving)
  userAgent String   // truncated to 256 chars
  referer   String?  // optional, truncated
  country   String?  // GeoIP lookup result (optional)

  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
}
